# Public gateway
RIPPLE_HOST=0.0.0.0
RIPPLE_PORT=8700
RIPPLE_DATA_DIR=runtime-data/agent-gateway
RIPPLE_DATABASE_URL=postgres://ripple_live:replace-with-a-private-password@127.0.0.1:5432/ripple_live
RIPPLE_DATABASE_MAX_CONNECTIONS=16
RIPPLE_POSTGRES_ROOT=runtime-data/postgres
# Comma-separated registration codes. Change before deployment.
RIPPLE_INVITE_CODES=replace-with-a-private-invite-code
# Each code can be redeemed this many times and expires after this many hours.
RIPPLE_INVITE_MAX_USES=10
RIPPLE_INVITE_TTL_HOURS=168
RIPPLE_AUTH_TOKEN_TTL_HOURS=720

# Internal inference endpoints
RIPPLE_ASR_URL=http://127.0.0.1:8711/v1/audio/transcriptions
RIPPLE_ASR_MODEL=Qwen3-ASR-1.7B
RIPPLE_AGENT_URL=http://127.0.0.1:8712/v1/responses
RIPPLE_AGENT_MODEL=Qwen3.5-35B-A3B
RIPPLE_GATE_TIMEOUT_MS=3000
RIPPLE_TTS_URL=http://127.0.0.1:8723/v1/audio/speech
RIPPLE_TTS_MODEL=Qwen3-TTS-12Hz-1.7B-CustomVoice
RIPPLE_TTS_VOICE=serena
RIPPLE_TTS_LANGUAGE=Chinese
RIPPLE_TTS_INSTRUCTIONS=自然、温暖、亲切的中文女声。语速适中，语气平静，停顿自然，像真人助手交流，避免播音腔和夸张情绪。
RIPPLE_AUDIO_CHUNK_MS=100
RIPPLE_CONTEXT_MAX_CHARS=12000
RIPPLE_SKILLS_DIR=skills
RIPPLE_CLI_MAX_OUTPUT_BYTES=262144
# Read-only external tools. Keep real credentials only in deploy/agent-stack/.env.
RIPPLE_TAVILY_API_KEY=
RIPPLE_TAVILY_API_URL=https://api.tavily.com
# QWeather assigns a project-specific API host. JWT uses an Ed25519 private key file.
RIPPLE_QWEATHER_API_HOST=
RIPPLE_QWEATHER_API_KEY=
RIPPLE_QWEATHER_PROJECT_ID=
RIPPLE_QWEATHER_CREDENTIAL_ID=
RIPPLE_QWEATHER_PRIVATE_KEY_PATH=
RIPPLE_TOOL_CACHE_DB=runtime-data/agent-gateway/tool-cache.sqlite3
# Optional dedicated proxy for outbound tool requests.
RIPPLE_SEARCH_PROXY=

# GPU allocation (physical GPU indices)
ASR_GPU=2
AGENT_GPU=3
AGENT_MODEL=Qwen3.5-35B-A3B
AGENT_RUNTIME=.venv-qwen3.5-35b-a3b
AGENT_TOOL_CALL_PARSER=qwen3_coder
AGENT_GPU_MEMORY_UTILIZATION=0.85
AGENT_MAX_NUM_SEQS=192
TTS_GPU=7
TTS_MODEL=Qwen3-TTS-12Hz-1.7B-CustomVoice
