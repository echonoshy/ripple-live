# Public gateway
RIPPLE_HOST=0.0.0.0
RIPPLE_PORT=8700
RIPPLE_DATA_DIR=.cache/agent-gateway

# Internal inference endpoints
RIPPLE_ASR_URL=http://127.0.0.1:8711/v1/audio/transcriptions
RIPPLE_ASR_MODEL=Qwen3-ASR-0.6B
RIPPLE_AGENT_URL=http://127.0.0.1:8712/v1/chat/completions
RIPPLE_AGENT_MODEL=Qwen3-VL-8B-Instruct
RIPPLE_TTS_URL=http://127.0.0.1:8723/v1/audio/speech
RIPPLE_TTS_MODEL=Qwen3-TTS-12Hz-1.7B-CustomVoice
RIPPLE_TTS_VOICE=serena
RIPPLE_TTS_LANGUAGE=Chinese
RIPPLE_TTS_INSTRUCTIONS=自然、温暖、亲切的中文女声。语速适中，语气平静，停顿自然，像真人助手交流，避免播音腔和夸张情绪。
RIPPLE_AUDIO_CHUNK_MS=100

# GPU allocation (physical GPU indices)
ASR_GPU=2
AGENT_GPU=3
TTS_OMNI_GPU=7
TTS_OMNI_MODEL=Qwen3-TTS-12Hz-1.7B-CustomVoice
