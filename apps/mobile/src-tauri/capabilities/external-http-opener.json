{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "external-http-opener",
  "description": "Allows Android and desktop builds to open validated web sources",
  "windows": [
    "main"
  ],
  "platforms": [
    "linux",
    "macOS",
    "windows",
    "android"
  ],
  "permissions": [
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://*" },
        { "url": "http://*" }
      ]
    }
  ]
}
