{
  "tools": [
    {
      "name": "web_search",
      "description": "使用 Tavily 搜索公开网页。需要联网、最新信息、新闻或外部资料时使用；返回标题、URL、相关摘要、发布时间和相关性。",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "简洁、具体的搜索查询",
            "minLength": 1,
            "maxLength": 200
          },
          "topic": {
            "type": "string",
            "description": "新闻类实时查询使用 news，其他使用 general",
            "enum": ["general", "news"],
            "default": "general"
          },
          "time_range": {
            "type": "string",
            "description": "可选的发布时间范围",
            "enum": ["day", "week", "month", "year"]
          },
          "max_results": {
            "type": "integer",
            "description": "返回来源数量",
            "minimum": 1,
            "maximum": 8,
            "default": 5
          }
        },
        "required": ["query"],
        "additionalProperties": false
      },
      "command": ["../../tools/ripple-tool/target/release/ripple-tool", "web-search"],
      "timeout_ms": 40000,
      "rate_limit_per_minute": 10,
      "env": [
        "RIPPLE_TAVILY_API_KEY",
        "RIPPLE_TAVILY_API_URL",
        "RIPPLE_TOOL_CACHE_DB",
        "HTTPS_PROXY",
        "HTTP_PROXY",
        "NO_PROXY"
      ],
      "confirmation": "never"
    },
    {
      "name": "web_fetch",
      "description": "通过 Tavily Extract 读取一个公开 http/https 网页的正文。用户提供 URL 或搜索摘要不足时使用；不得访问本机或私网地址。",
      "input_schema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "需要读取的完整公开网页 URL",
            "minLength": 1,
            "maxLength": 2048
          },
          "query": {
            "type": "string",
            "description": "可选：希望从正文中重点提取的问题",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": ["url"],
        "additionalProperties": false
      },
      "command": ["../../tools/ripple-tool/target/release/ripple-tool", "web-fetch"],
      "timeout_ms": 45000,
      "rate_limit_per_minute": 10,
      "env": [
        "RIPPLE_TAVILY_API_KEY",
        "RIPPLE_TAVILY_API_URL",
        "RIPPLE_TOOL_CACHE_DB",
        "HTTPS_PROXY",
        "HTTP_PROXY",
        "NO_PROXY"
      ],
      "confirmation": "never"
    }
  ]
}
