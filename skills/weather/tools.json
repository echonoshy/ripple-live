{
  "tools": [
    {
      "name": "weather_lookup",
      "description": "使用和风天气查询指定地点的实时天气和未来预报。天气问题应直接调用本工具；小时级问题设置 include_hourly=true。",
      "input_schema": {
        "type": "object",
        "properties": {
          "location": {
            "type": "string",
            "description": "地点名称，尽量包含城市和区县，例如 北京市朝阳区",
            "minLength": 1,
            "maxLength": 100
          },
          "days": {
            "type": "integer",
            "description": "未来预报天数，范围 1 到 7",
            "minimum": 1,
            "maximum": 7,
            "default": 3
          },
          "include_hourly": {
            "type": "boolean",
            "description": "是否返回未来最多 24 小时逐小时预报",
            "default": false
          }
        },
        "required": ["location"],
        "additionalProperties": false
      },
      "command": ["../../tools/ripple-tool/target/release/ripple-tool", "weather-lookup"],
      "timeout_ms": 35000,
      "rate_limit_per_minute": 20,
      "env": [
        "RIPPLE_QWEATHER_API_HOST",
        "RIPPLE_QWEATHER_API_KEY",
        "RIPPLE_QWEATHER_PROJECT_ID",
        "RIPPLE_QWEATHER_CREDENTIAL_ID",
        "RIPPLE_QWEATHER_PRIVATE_KEY_PATH",
        "RIPPLE_TOOL_CACHE_DB",
        "HTTPS_PROXY",
        "HTTP_PROXY",
        "NO_PROXY"
      ],
      "confirmation": "never"
    }
  ]
}
